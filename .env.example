# Variables para deploy (Render). No commitear valores reales.
# Copiá la URI desde Supabase → Project Settings → Database → Connect → Session pooler → URI.

SUPABASE_DB_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Opcional si la contraseña no va en la URI:
# SUPABASE_DB_PASSWORD=

# URL pública del backend en Render (para pruebas curl y Netlify):
# RENDER_API_URL=https://control-vacantes-1.onrender.com
